# ==============================================================================
# Forsis AI Agent — Plantilla de Variables de Entorno (.env.example)
# COPIAR A .env Y COMPLETAR CON VALORES REALES: cp .env.example .env && chmod 600 .env
# NUNCA COMITEAR EL ARCHIVO .env A CONTROL DE VERSIONES
# ==============================================================================

# --- Aplicación Python/FastAPI ---
APP_NAME="Forsis AI Agent"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://forsispr1.ddns.net:8099
APP_TIMEZONE=America/Mexico_City
LOG_LEVEL=info

# --- Base de Datos PROPIA del Agente (PostgreSQL 16) ---
DB_CONNECTION=postgresql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=forsis_agent
DB_USERNAME=forsis_agent
DB_PASSWORD=[REDACTED_STRONG_DB_PASSWORD]
# Variables para el contenedor postgres:16-alpine
POSTGRES_DB=forsis_agent
POSTGRES_USER=forsis_agent
POSTGRES_PASSWORD=[REDACTED_STRONG_DB_PASSWORD]

# --- Memoria Vectorial Compartida (pgvector en ai-network) ---
MEMORY_DB_HOST=forsis-memory
MEMORY_DB_PORT=5432
MEMORY_DB_DATABASE=forsis_memory
MEMORY_DB_USERNAME=[REDACTED]
MEMORY_DB_PASSWORD=[REDACTED]

# --- LLM Inferencia (Omniroute Gateway) — VERIFICADO FASE 1 ---
# Puerto 20130 (API + Dashboard unificado), ruta /v1/chat/completions
OMNIROUTE_BASE_URL=http://host.docker.internal:20130/v1
OMNIROUTE_API_KEY=[REDACTED_OR_EMPTY_IF_REQUIRE_API_KEY_FALSE]
OMNIROUTE_MODEL=Forsis
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=2

# --- Integraciones de Comunicación ---
MATTERMOST_URL=https://chatforsis.ddns.net
MATTERMOST_BOT_TOKEN=[REDACTED_MATTERMOST_TOKEN]
MATTERMOST_TEAM_ID=[REDACTED]
MATTERMOST_CHANNEL_OPERACIONES=[REDACTED]

# --- Acceso Read-Only al ERP (trafico-db PostgreSQL / SICRET MySQL) ---
# REGLA: El agente SOLO se conecta con GRANT SELECT, transacción ReadOnlySession.
# CERO permisos INSERT/UPDATE/DELETE/ALTER.
# trafico-db (MariaDB 11, contenedor Docker)
ERP_TRAFICO_HOST=172.17.0.1
ERP_TRAFICO_PORT=3306
ERP_TRAFICO_DATABASE=trafico
ERP_TRAFICO_USERNAME=[REDACTED_READONLY_USER]
ERP_TRAFICO_PASSWORD=[REDACTED_READONLY_PASS]

# SICRET MySQL en 192.168.1.209:3306 (NO TLS, --ssl=0)
# sicrePR es latin1, sicre2PR/sicreGero/sicre2Gero también
ERP_SICRET_HOST=192.168.1.209
ERP_SICRET_PORT=3306
ERP_SICRET_DATABASE_PR=sicrePR
ERP_SICRET_DATABASE_GERO=sicreGero
ERP_SICRET_USERNAME=[REDACTED_READONLY_USER]
ERP_SICRET_PASSWORD=[REDACTED_READONLY_PASS]
ERP_SICRET_CHARSET=latin1
ERP_SICRET_SSL_DISABLED=true

# --- API REST de Tráfico (para mutaciones controladas vía HTTP) ---
TRAFICO_API_BASE_URL=https://forsispr1.ddns.net:8443/api
TRAFICO_API_TOKEN=[REDACTED_SERVICE_ACCOUNT_TOKEN]

# --- Guardrails de Ejecución Operacional ---
AGENT_MAX_TURNS_PER_SESSION=25
AGENT_DEFAULT_CONFIDENCE_THRESHOLD=0.85
AGENT_DRY_RUN_DEFAULT=true
# Allowlist vacía = fail-closed: ninguna acción de mutación se ejecuta sin estar explícitamente listada
AGENT_WRITE_ALLOWLIST=""

# --- Migraciones (solo en primer arranque, desactivar en runtime normal) ---
RUN_MIGRATIONS=false
